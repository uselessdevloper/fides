# Nebius Token Factory API Configuration
# Get your API key from https://tokenfactory.nebius.com/
NEBIUS_API_KEY=your_token_factory_api_key

# NVIDIA Model Identifier on Nebius Token Factory
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
